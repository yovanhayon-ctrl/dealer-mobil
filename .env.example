# PRODUCTION (wajib): APP_ENV=production, APP_DEBUG=false, APP_URL=https://domain-anda,
# LOG_LEVEL=warning, SESSION_SECURE_COOKIE=true (butuh HTTPS). Lihat README bagian Keamanan.
APP_NAME="JAF Dealer"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production lewat HTTPS: true agar cookie sesi hanya dikirim lewat koneksi aman.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Demo dengan Mailtrap (email masuk ke inbox Mailtrap, tidak ke penerima asli):
# MAIL_MAILER=smtp
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=(dari Mailtrap > Inboxes > SMTP Settings)
# MAIL_PASSWORD=(dari Mailtrap > Inboxes > SMTP Settings)

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

DEALER_NAME="JAF Dealer"
DEALER_TAGLINE="Dream the Legacy. Drive the Future."
DEALER_ADDRESS=
DEALER_PHONE=
DEALER_WHATSAPP=
DEALER_EMAIL=
DEALER_HOURS=
DEALER_MAPS_EMBED_URL=
# Kirim notifikasi juga lewat email (true/false).
DEALER_MAIL_NOTIFICATIONS=true

ADMIN_EMAIL=
ADMIN_PASSWORD=

# Kata sandi customer dummy (CustomerSeeder, hanya local/testing). Kosong = seeder dilewati.
SEED_CUSTOMER_PASSWORD=
